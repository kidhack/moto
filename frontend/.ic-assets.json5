[
  {
    "match": "**/*",
    "security_policy": "standard"
  },
  {
    "match": ".well-known",
    "ignore": false
  },
  {
    "match": ".well-known/ic-domains",
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Content-Type": "text/plain"
    },
    "allow_raw_access": true
  },
  {
    "match": ".well-known/ii-alternative-origins",
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Content-Type": "application/json"
    },
    "allow_raw_access": true
  }
]

