# Local development (.env). Production builds use .env.testnet / .env.mainnet instead.

# true = ckTESTBTC (testnet), false = real ckBTC
VITE_USE_TESTNET=true

# local = local replica + local Internet Identity, ic = mainnet
VITE_DFX_NETWORK=local

# Backend canister ID (local: `dfx canister id moto`)
VITE_CANISTER_ID_MOTO=

# Optional overrides (defaults are chosen from VITE_USE_TESTNET)
# VITE_CKBTC_MINTER_CANISTER_ID=
# VITE_CKBTC_LEDGER_CANISTER_ID=
# VITE_CKBTC_INDEX_CANISTER_ID=

# App fee (defaults: 0.5%, capped at $100, paid to the treasury principal)
# VITE_FEE_PERCENT=0.5
# VITE_FEE_CAP_USD=100
# VITE_FEE_TREASURY_PRINCIPAL=

# Break-glass price proxy via allorigins.win (default false)
# VITE_ENABLE_PROXY_FALLBACK=false
