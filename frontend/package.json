{
  "name": "moto-frontend",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "echo \"Use npm run build:testnet or npm run build:mainnet\" && exit 1",
    "build:testnet": "tsc && vite build --mode testnet",
    "build:mainnet": "tsc && vite build --mode mainnet",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
