    "@dfinity/ledger-icrc": "^6.0.1",
    "@dfinity/principal": "^3.4.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.294.0",
    "motion": "^12.34.1",
    "next-themes": "^0.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
