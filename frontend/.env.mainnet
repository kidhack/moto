# Mainnet build: real ckBTC. Used by `npm run build:mainnet`.
# Every network/fee key is set here so values from a local .env can't leak into the build.
VITE_USE_TESTNET=false
VITE_DFX_NETWORK=ic
VITE_CANISTER_ID_MOTO=2en3s-2iaaa-aaaad-qhqja-cai

# Empty = use the built-in mainnet IDs
VITE_CKBTC_MINTER_CANISTER_ID=
VITE_CKBTC_LEDGER_CANISTER_ID=
VITE_CKBTC_INDEX_CANISTER_ID=

VITE_FEE_PERCENT=0.5
VITE_FEE_CAP_USD=100
VITE_FEE_TREASURY_PRINCIPAL=c65im-m2qxx-7nvqc-fl62p-4xqmt-emdce-tmtqf-fggqq-3zh4d-yhdre-2qe
VITE_ENABLE_PROXY_FALLBACK=false
