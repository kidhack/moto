{
  "version": 1,
  "canisters": {
    "market_town": {
      "type": "motoko",
      "main": "backend/main.mo"
    },
    "market_town_frontend": {
      "type": "assets",
      "source": ["frontend/dist"],
      "dependencies": ["market_town"]
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "remote": {
        "id": {
