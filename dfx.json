{
  "version": 1,
  "canisters": {
    "internet_identity": {
      "type": "custom",
      "candid": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.did",
      "wasm": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.wasm.gz",
      "shrink": false
    },
    "market_town": {
      "type": "motoko",
      "main": "backend/main.mo"
    },
    "market_town_frontend": {
      "type": "assets",
      "source": ["frontend/dist"],
      "dependencies": ["market_town"]
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "remote": {
        "id": {
          "type": "principal"
        }
      },
      "type": "persistent"
    }
  }
}

