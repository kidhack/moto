{
  "version": 1,
  "canisters": {
    "internet_identity": {
      "type": "custom",
      "candid": "https://github.com/dfinity/internet-identity/releases/latest/download/internet_identity.did",
      "wasm": ".dfx/local/canisters/internet_identity/internet_identity.wasm"
    },
    "bitcoin_wallet": {
      "type": "motoko",
      "main": "backend/main.mo"
    },
    "bitcoin_wallet_frontend": {
      "type": "assets",
      "source": ["frontend"],
      "dependencies": ["bitcoin_wallet"]
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "remote": {
        "id": {
          "type": "principal"
        }
      },
      "type": "persistent"
    }
  }
}

